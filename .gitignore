# Rust build artefacts
target/

# Cargo.lock is intentionally committed: NFR-BUILD-010 requires every dependency to be
# pinned by a lockfile, and the spikes' lockfiles are the record of exactly which
# versions the S-3 and S-4 results were measured against.

# Generated spike fixtures (S-1): reproducible from a seed per D-19.1, not captured data,
# and not worth carrying as binary blobs in history.
spikes/*/fixtures/

# Editors
.vscode/
.idea/
*.iml
*.swp
*~

# OS
Thumbs.db
desktop.ini
.DS_Store

# Kernel/ETW traces produced by xperf during performance investigation (can be hundreds of MB).
trace.etl
*.etl

# Where the clap-validator CI job (FR-CLAP-020) stages the built plugin as `Namir.clap` before
# running the validator against it. A ~7 MB cdylib copy, reproducible from a build; running that
# job locally leaves one behind.
staging/

# Written by the headless-window smoke step (.github/workflows/ci.yml) when run by hand.
smoke.log
